  "instructions": [
    {
      "tags": [
        "llm"
      ],
      "msg": "Supply url, jsonData.flavor, jsonData.version and jsonData.timeField for every connection. Use proxy access for backend queries and resource requests. When connecting directly to Amazon OpenSearch Serverless, set jsonData.serverless=true, jsonData.sigV4Auth=true, jsonData.flavor=opensearch and jsonData.version=1.0.0. For a provisioned cluster, supply its actual version. Store the index in jsonData.database."
    },
    {
      "tags": [
        "llm"
      ],
      "msg": "Use sigV4-prefixed keys for AWS authentication. Select a provider allowed by the Grafana instance. Set the signing region even when the AWS SDK supplies credentials. For Grafana Assume Role, supply the customer role ARN and let Grafana manage its external ID."
    },
    {
      "tags": [
        "llm"
      ],
      "msg": "For provisioning, use secureJsonData for passwords, certificates, tokens and AWS keys. For a custom header, pair jsonData.httpHeaderName1 with secureJsonData.httpHeaderValue1 and number subsequent pairs consecutively. On an existing data source, secureJsonFields reports which secrets are set."
    }
  ]
}

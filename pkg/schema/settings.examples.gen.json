{
  "examples": {
    "": {
      "summary": "OpenSearch without authentication",
      "value": {
        "apiVersion": "grafana-opensearch-datasource.datasource.grafana.app/v0alpha1",
        "kind": "DataSource",
        "metadata": {
          "name": "opensearch"
        },
        "spec": {
          "access": "proxy",
          "jsonData": {
            "database": "\u003cINDEX_NAME\u003e",
            "flavor": "opensearch",
            "timeField": "@timestamp",
            "version": "2.18.0"
          },
          "title": "OpenSearch",
          "url": "\u003cOPENSEARCH_URL\u003e"
        }
      }
    },
    "authorizationHeader": {
      "summary": "Custom authorization header",
      "value": {
        "apiVersion": "grafana-opensearch-datasource.datasource.grafana.app/v0alpha1",
        "kind": "DataSource",
        "metadata": {
          "name": "opensearch"
        },
        "secure": {
          "httpHeaderValue1": {
            "create": "Bearer \u003cTOKEN\u003e"
          }
        },
        "spec": {
          "access": "proxy",
          "jsonData": {
            "database": "\u003cINDEX_NAME\u003e",
            "flavor": "opensearch",
            "httpHeaderName1": "Authorization",
            "timeField": "@timestamp",
            "version": "2.18.0"
          },
          "title": "OpenSearch",
          "url": "\u003cOPENSEARCH_URL\u003e"
        }
      }
    },
    "awsCredentialsFile": {
      "summary": "AWS credentials file",
      "value": {
        "apiVersion": "grafana-opensearch-datasource.datasource.grafana.app/v0alpha1",
        "kind": "DataSource",
        "metadata": {
          "name": "opensearch"
        },
        "spec": {
          "access": "proxy",
